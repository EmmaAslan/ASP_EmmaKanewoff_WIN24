@model SignUpFormData
@{
    Layout = "_Layout_CenterScreen";
    ViewData["Title"] = "Create Account";
}

<section id="signup">

    <h1>@ViewData["Title"]</h1>
    <form asp-controller="Auth" asp-action="SignUp" method="post" novalidate>

        @if (!string.IsNullOrEmpty(ViewBag?.ErrorMessage))
        {
            <div class="error-message">
                @ViewBag?.ErrorMessage
            </div>
        }
        <div class="form-group-fullName">
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="FirstName"></label>
                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                </div>
                <input asp-for="FirstName" />
                
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label asp-for="LastName"></label>
                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                </div>
                
                <input asp-for="LastName" />
                
            </div>
        </div>

        <div class="form-group">
            <div class="label-row">
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            
            <input asp-for="Email" />
            
        </div>

        <div class="form-group">
            <div class="label-row">
                <label asp-for="Password"></label>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            
            <input asp-for="Password" />
            
        </div>

        <div class="form-group">
            <div class="label-row">
                <label asp-for="ConfirmPassword"></label>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            
            <input asp-for="ConfirmPassword" />
            
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-submit">Sign Up</button>
        </div>

        <div class="form-footer">
            <span>Already have an account?</span>
            <a asp-controller="Auth" asp-action="Login">Log In</a>
        </div>

    </form>





</section>
@model EditProjectForm

@{
    ViewData["Title"] = "Edit Project";
}

<div id="editProjectModal" class="modal">
    <section class="container add-project-section modal-content">
        <form novalidate method="post" asp-action="EditProject" asp-controller="Projects">
            <div class="topRow modal-header">
                <h3>Edit Project</h3>
                <button type="button" class="" data-close="true"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <input asp-for="Id" readonly type="hidden"/>

            <img src="/images/project_img.svg" alt="" class="project-img">

            <div class="input-box">
                <div>
                    <label asp-for="ProjectName">Project Name</label> <span asp-validation-for="ProjectName" class="field-validation-error"></span>
                    <input type="text" id="projectName" name="ProjectName" asp-for="ProjectName" class="input-oneRow">
                </div>

                <div>
                    <label asp-for="ClientName">Client Name</label> <span asp-validation-for="ClientName" class="field-validation-error"></span>
                    <input type="text" id="clientName" name="ClientName" asp-for="ClientName" class="input-oneRow">
                </div>

                <div>
                    <label asp-for="Description">Description</label>
                    <div class="wysiwyg">
                        <textarea asp-for="Description" name="Description"></textarea>
                        <div id="editProject-wysiwyg-editor" class="wysiwyg-editor"></div>
                        <div id="editProject-wysiwyg-toolbar">
                            <span class="ql-formats">
                                <button class="ql-bold"></button>
                                <button class="ql-italic"></button>
                                <button class="ql-underline"></button>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-align" value=""></button>
                                <button class="ql-align" value="center"></button>
                                <button class="ql-align" value="right"></button>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-list" value="bullet"></button>
                                <button class="ql-list" value="ordered"></button>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-link"></button>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="date-row">
                    <div>
                        <label asp-for="StartDate">Start Date</label> <span asp-validation-for="StartDate" class="field-validation-error"></span>
                        <input type="date" id="startDate" name="StartDate" asp-for="StartDate" class="input-oneRow">
                    </div>
                    <div>
                        <label asp-for="EndDate">End Date</label>
                        <input type="date" id="endDate" name="EndDate" asp-for="EndDate" class="input-oneRow">
                    </div>
                </div>

                <div class="budget">
                    <label asp-for="Budget">Budget</label>
                    <input type="text" id="budget" name="Budget" asp-for="Budget" class="input-oneRow">
                </div>

                <div class="status">
                    <label asp-for="Status">Status</label>  <span asp-validation-for="Status" class="field-validation-error"></span>
                    <select name="StatusId" id="status" asp-for="StatusId" class="input-oneRow" required>
                        <option value="" disabled selected class="placeholder-select">Select status</option>
                        @foreach (var status in await _statusRepository.GetAllAsync())
                        {
                            <option value="@status.Id">@status.StatusName</option>
                        } 

        

                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-submit">Update</button>
        </form>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        handleEditWysiwyg('#editProject-wysiwyg-editor', '#editProject-wysiwyg-toolbar', '#Description', '@Html.Raw(ViewBag.Description ?? "")')

        const editProjectBtn = document.querySelectorAll('#editProject-btn');

        editProjectBtn.forEach((btn) => {
            btn.addEventListener('click', async function() {
                const projectId = this.getAttribute('data-projectId');
            
                if (projectId) {
                    try {
                        // Fetch project data
                        const response = await fetch(`api/getprojects/${projectId}`);
                        console.log(response);
                       
                        if (response.ok) {
                            const memberdata = await response.json();
                            console.log(memberdata)
                          

                            // Start initilize of rich text
                            handleEditWysiwyg('#editProject-wysiwyg-editor', '#editProject-wysiwyg-toolbar', '#Description', memberdata.description);

                            // Populate form fields
                            const form = document.querySelector('#editProjectModal form');
                            form.querySelector('[name="Id"]').value = memberdata.id;
                            form.querySelector('[name="ProjectName"]').value = memberdata.projectName;
                            form.querySelector('[name="ClientName"]').value = memberdata.clientName;
                            form.querySelector('[name="Description"]').value = memberdata.description;
                            form.querySelector('[name="StartDate"]').value = memberdata.startDate;
                            form.querySelector('[name="EndDate"]').value = memberdata.endDate;
                            form.querySelector('[name="Budget"]').value = memberdata.budget;
                            form.querySelector('[name="StatusId"]').value = memberdata.statusId;
                        }
                    } catch (error) {
                        console.error('Error fetching project data:', error);
                    }
                }

            })
        })

    

    })

    function handleEditWysiwyg(wysiwygEditorId, wysiwygToolbarId, textareaId, content) {
        const textarea = document.querySelector(textareaId)
        const quill = new Quill(wysiwygEditorId, {
            modules: {
                syntax: true,
                toolbar: wysiwygToolbarId,
            },
            placeholder: 'Enter project description',
            theme: 'snow'
        })

        if (content) {
            quill.root.innerHTML = content;

            quill.on('text-change', () => {
                textarea.value = quill.root.innerHTML;
            })
        }
    }


@model Project

<div class="card">
    <div class="card-top">
        <div class="card-img-title-company">
            <div class="card-img"><img src="/images/project_img.svg"></div>
            <div class="card-title-company">
                <div class="card-title"><h6>@Model.ProjectName</h6></div>
                <div class="card-company">@Model.ClientName</div>
            </div>
        </div>

        <div class="card-moreOptions">
            <i class="fa-solid fa-ellipsis" onclick="openEditRemove(this)"></i>

             <div class="card-setting-box">
                <div id="editProject-btn" class="card-setting-box-edit" data-modal="true" data-target="#editProjectModal" data-projectId="@Model.Id"  @* onclick="loadData('@Model.Id')'" *@>
                    <img src="/images/Edit_icon.svg">
                    <p>Edit</p>
                </div>

                <div class="divider"></div>

                <div class="card-setting-box-delete">
                    <img src="/images/Delete_icon.svg">
                    <p>Delete Project</p>
                </div>
            </div> 
           
        </div>

        

    </div>
    <div class="card-description">
        <p class="text">@Model.Description</p>
    </div>
</div>


<script>
    function openEditRemove(e) {
        var card = e.closest('.card-moreOptions');
        var cardSettingBox = card.querySelector('.card-setting-box');
        cardSettingBox.classList.toggle('card-setting-box-active');
    }
</script>
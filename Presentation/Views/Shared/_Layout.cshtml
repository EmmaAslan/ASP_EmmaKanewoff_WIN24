<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Backend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://kit.fontawesome.com/a576612222.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
</head>
<body>

    <div class="wrapper-portal">
        <aside class="sidebar">
            <partial name="Partials/_LinkLogotype" />
            <partial name="Partials/_NavbarPartial" />
        </aside>

        <header class="header">
            @await Html.PartialAsync("Partials/_TopbarPartial")
        </header>
        <main class="main">
            @RenderBody()
        </main>
    </div>
    

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/w.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
